{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "deposit_submitted": {
      "const": false
    },
    "depositAddress": {
      "type": "null"
    },
    "depositMemo": {
      "type": "null"
    },
    "live_near_transaction": {
      "const": false
    },
    "mode": {
      "const": "mock"
    },
    "near_status": {
      "type": "null"
    },
    "refund": {
      "additionalProperties": true,
      "properties": {
        "actualRefundedAmount": {
          "type": "null"
        },
        "policy_status": {
          "const": "mock_refundable_if_proof_fails"
        },
        "refundableAmount": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "refundPolicyReason": {
          "const": "PROOF_NOT_VERIFIED_IN_DRY_RUN"
        },
        "refundTo": {
          "type": "string"
        },
        "refundType": {
          "enum": [
            "ORIGIN_CHAIN",
            "INTENTS",
            "CONFIDENTIAL_INTENTS"
          ]
        }
      },
      "required": [
        "policy_status",
        "refundTo",
        "refundType",
        "refundPolicyReason",
        "refundableAmount",
        "actualRefundedAmount"
      ],
      "type": "object"
    },
    "schema": {
      "const": "auto-near-1click-status-refund-receipt/v1"
    },
    "spendful": {
      "const": false
    },
    "status": {
      "enum": [
        "NO_DEPOSIT_DRY_RUN"
      ]
    },
    "status_endpoint_called": {
      "const": false
    },
    "status_refund_receipt_id": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status_refund_receipt_id",
    "intent_id",
    "settlement_id",
    "status",
    "mode",
    "spendful",
    "live_near_transaction",
    "status_endpoint_called",
    "deposit_submitted",
    "depositAddress",
    "depositMemo",
    "near_status",
    "refund"
  ],
  "title": "AUTO NEAR 1Click Mock Status Refund Receipt",
  "type": "object"
}
