{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "dry": {
      "const": true
    },
    "intent_id": {
      "type": "string"
    },
    "live_near_transaction": {
      "const": false
    },
    "quoteRequest": {
      "additionalProperties": true,
      "properties": {
        "amount": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "confidentiality": {
          "enum": [
            "public",
            "basic",
            "advanced"
          ]
        },
        "deadline": {
          "type": "string"
        },
        "depositMode": {
          "enum": [
            "SIMPLE",
            "MEMO"
          ]
        },
        "depositType": {
          "enum": [
            "ORIGIN_CHAIN",
            "INTENTS",
            "CONFIDENTIAL_INTENTS"
          ]
        },
        "destinationAsset": {
          "type": "string"
        },
        "dry": {
          "const": true
        },
        "originAsset": {
          "type": "string"
        },
        "quoteWaitingTimeMs": {
          "type": "integer"
        },
        "recipient": {
          "type": "string"
        },
        "recipientType": {
          "enum": [
            "DESTINATION_CHAIN",
            "INTENTS",
            "CONFIDENTIAL_INTENTS"
          ]
        },
        "refundTo": {
          "type": "string"
        },
        "refundType": {
          "enum": [
            "ORIGIN_CHAIN",
            "INTENTS",
            "CONFIDENTIAL_INTENTS"
          ]
        },
        "slippageTolerance": {
          "type": "integer"
        },
        "swapType": {
          "enum": [
            "EXACT_INPUT",
            "EXACT_OUTPUT",
            "FLEX_INPUT",
            "ANY_INPUT"
          ]
        }
      },
      "required": [
        "dry",
        "swapType",
        "slippageTolerance",
        "originAsset",
        "depositType",
        "destinationAsset",
        "amount",
        "recipient",
        "recipientType",
        "refundTo",
        "refundType",
        "deadline",
        "depositMode"
      ],
      "type": "object"
    },
    "quote_request_id": {
      "type": "string"
    },
    "schema": {
      "const": "auto-near-1click-quote-request/v1"
    },
    "spendful": {
      "const": false
    }
  },
  "required": [
    "schema",
    "quote_request_id",
    "intent_id",
    "quoteRequest",
    "dry",
    "spendful",
    "live_near_transaction"
  ],
  "title": "AUTO NEAR 1Click Dry Quote Request",
  "type": "object"
}
